# Copia este archivo como .env solo para referencia: en Render estas variables se escriben en el panel.
# Nunca subas a GitHub la clave de la cuenta de servicio ni la clave de Groq.

APP_NAME=Rumbo 11
FIREBASE_PROJECT_ID=tu-proyecto-firebase
# Contenido completo del JSON de la cuenta de servicio (Firebase > Configuración > Cuentas de servicio), en una sola línea.
FIREBASE_SERVICE_ACCOUNT_JSON=
# Correos que entran como administrador (deben verificar su correo). Separados por coma.
ADMIN_EMAILS=
# Dirección de la web, sin barra final. Se usa para CORS y para armar los enlaces de autorización.
CORS_ORIGINS=https://tu-proyecto-firebase.web.app
FRONTEND_URL=https://tu-proyecto-firebase.web.app

# Tutor. Sin clave, el tutor responde solo con las pistas validadas de cada pregunta.
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant
TUTOR_DAILY_LIMIT=20

# Correo opcional con Brevo. Sin clave, el colegio copia y comparte los enlaces.
BREVO_API_KEY=
MAIL_FROM=

# Texto largo y secreto: con él se generan los identificadores anónimos de la investigación. No lo cambies después de empezar.
RESEARCH_SALT=
# En uso real debe ser false: solo se usan preguntas aprobadas por un docente.
ALLOW_UNREVIEWED_ITEMS=false
